{
  "name": "valtec-tts",
  "displayName": "Valtec TTS Provider",
  "publisher": "haidv",
  "version": "0.1.0",
  "description": "Offline Vietnamese neural Text-to-Speech extension using Valtec VITS ONNX model.",
  "starter": {
    "kind": "tts"
  },
  "engines": {
    "enovel": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "icon": "./public/icon.png",
  "activationEvents": [
    "always"
  ],
  "categories": [
    "TTS"
  ],
  "keywords": [
    "e-novels",
    "tts",
    "valtec",
    "vietnamese",
    "onnx"
  ],
  "permissions": [
    "tts",
    "storage",
    "network"
  ],
  "network": {
    "allowedHosts": [
      "raw.githubusercontent.com"
    ]
  },
  "contributes": {
    "tts": {
      "name": "Valtec Vietnamese TTS",
      "description": "Offline Vietnamese neural Text-to-Speech extension using Valtec VITS ONNX model.",
      "version": 1,
      "mode": "wasm",
      "capabilities": [
        "getVoices",
        "speak",
        "stop"
      ]
    }
  }
}
